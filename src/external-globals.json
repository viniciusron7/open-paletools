  "$undeclaredInOriginal": "Referenced by the original script but declared nowhere (neither here nor, as far as known, by the Web App). The code paths that reach them throw ReferenceError; they are kept as-is to preserve behavior. Each name is allowed only in the modules listed for it, so new code that uses one of these names undeclared is still reported.",
  "undeclaredInOriginal": {
    "addStyles": ["src/plugins/lowest-market-price/index.js"],
    "i": ["src/core/prototype-override.js"],
    "info": ["src/plugins/snipe/index.js"],
    "remove": ["src/plugins/sbc-template-builder/enhanced-search-filters-control.js"],
    "removeStyles": ["src/plugins/lowest-market-price/index.js"],
    "response": ["src/plugins/snipe/index.js"],
    "saveConfiguration": [
      "src/plugins/import-sbc/index.js",
      "src/plugins/improved-player-search/index.js"
    ],
    "updateConfiguration": ["src/plugins/settings/settings-view.js"]
  }
